.idea/

# Editors and assistants — keep local settings out of version control.
# Note: .codegraph/ manages itself via .codegraph/.gitignore, so it is
# intentionally not listed here (listing it would flag the tracked
# .codegraph/.gitignore as "checked in while ignored").
.vscode/
.cursor/
.omo/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
# The leading slash keeps example/pubspec.lock (an app lockfile) tracked.
/pubspec.lock
**/doc/api/
**/.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
**/generated_plugin_registrant.dart
coverage/
.coverage

# FVM Version Cache
.fvm/